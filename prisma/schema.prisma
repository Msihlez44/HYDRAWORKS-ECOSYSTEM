generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  DRIVER
  SERVICE_PROVIDER
  WORKER
  SUPPLIER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum StockRequestStatus {
  DRAFT
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  SHOPPING
  AWAITING_APPROVAL
  PURCHASED
  DELIVERING
  ARRIVED
  DELIVERED
  CANCELLED
  DISPUTED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
  TRANSFER
}

enum PaymentMethod {
  CASH
  CARD
  EFT
  HYDRA_WALLET
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND
  COMMISSION
  WITHDRAWAL
  ADJUSTMENT
}

enum FinancialStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ServiceJobStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  WORK_STARTED
  COMPLETED
  CUSTOMER_CONFIRMED
  PAYMENT_RELEASED
  REVIEWED
  CANCELLED
  DISPUTED
}

enum EmploymentType {
  PERMANENT
  TEMPORARY
  CONTRACT
  CASUAL
  DAILY
  FREELANCE
  INTERNSHIP
  LEARNERSHIP
}

enum JobStatus {
  DRAFT
  OPEN
  FILLED
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  SELECTED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum AssignmentStatus {
  PENDING_ACCEPTANCE
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum SupplierOrderStatus {
  PLACED
  ACCEPTED
  PREPARING
  READY_FOR_PICKUP
  IN_DELIVERY
  DELIVERED
  CANCELLED
  DISPUTED
}

enum HostingRequestStatus {
  REQUESTED
  QUOTED
  PAID
  PROVISIONING
  ACTIVE
  SUSPENDED
  CANCELLED
  FAILED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
  OVERDUE
}

enum ProvisionStatus {
  PENDING_ADMIN
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ConversationContext {
  DELIVERY
  SERVICE_REQUEST
  JOB
  SUPPLIER_ORDER
  SUPPORT_TICKET
  HOSTING_REQUEST
}

enum MessageAttachmentType {
  IMAGE
  DOCUMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationEvent {
  NEW_DELIVERY_REQUEST
  DRIVER_ASSIGNED
  PURCHASE_APPROVAL
  DELIVERY_ARRIVING
  DELIVERY_COMPLETE
  LOW_STOCK
  SERVICE_QUOTE
  JOB_MATCH
  PAYMENT_RECEIVED
  VERIFICATION_UPDATE
  SUPPORT_REPLY
}

enum DeliveryAttemptStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum VerificationType {
  PERSON
  BUSINESS
  DRIVER
  SERVICE_PROVIDER
  SUPPLIER
  WORKER
}

enum VerificationCaseStatus {
  PENDING
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
}

enum VerificationDecision {
  SUBMITTED
  ASSIGNED
  APPROVED
  REJECTED
  REQUEST_MORE_INFORMATION
  RESUBMITTED
}

enum SupportCategory {
  PAYMENTS
  DELIVERY
  DRIVER
  STOCK
  SERVICE_PROVIDER
  EMPLOYMENT
  ACCOUNT
  VERIFICATION
  TECHNICAL
}

enum SupportStatus {
  OPEN
  ASSIGNED
  WAITING
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EcosystemBillingPeriod {
  MONTHLY
  ANNUAL
}

enum EcosystemSubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELLED
}

model User {
  id                      String                    @id @default(cuid())
  email                   String                    @unique
  phone                   String                    @unique
  passwordHash            String
  firstName               String
  lastName                String
  province                String?
  status                  AccountStatus             @default(ACTIVE)
  roles                   UserRole[]
  businesses              BusinessMember[]
  sessions                Session[]
  auditLogs               AuditLog[]
  driverProfile           DriverProfile?
  drivingRequests         StockRequest[]            @relation("AssignedDriver")
  reviewsWritten          Review[]                  @relation("ReviewAuthor")
  reviewsReceived         Review[]                  @relation("ReviewSubject")
  wallet                  Wallet?
  serviceProvider         ServiceProvider?
  serviceRequests         ServiceRequest[]          @relation("ServiceCustomer")
  serviceReviewsWritten   ServiceReview[]           @relation("ServiceReviewAuthor")
  serviceReviewsReceived  ServiceReview[]           @relation("ServiceReviewSubject")
  workerProfile           WorkerProfile?
  jobApplications         JobApplication[]
  conversationMemberships ConversationParticipant[]
  messagesSent            Message[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  verificationCases       VerificationCase[]        @relation("VerificationApplicant")
  verificationReviews     VerificationCase[]        @relation("VerificationReviewer")
  verificationActions     VerificationAction[]      @relation("VerificationActor")
  supportTickets          SupportTicket[]           @relation("SupportRequester")
  assignedTickets         SupportTicket[]           @relation("SupportAssignee")
  supportActions          SupportAction[]
  supportPartyMemberships SupportTicketParty[]
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([status, province, createdAt])
}

model UserRole {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role

  @@unique([userId, role])
}

model Business {
  id                     String                  @id @default(cuid())
  name                   String
  storefrontSlug         String?                 @unique
  storefrontPublished    Boolean                 @default(false)
  logoUrl                String?
  publicDescription      String?
  openingHours           String?
  serviceArea            String?
  publicPhone            String?
  publicEmail            String?
  whatsappNumber         String?
  orderUrl               String?
  registrationNumber     String?                 @unique
  address                String?
  province               String?
  verificationStatus     String                  @default("PENDING")
  members                BusinessMember[]
  stockRequests          StockRequest[]
  products               Product[]
  sales                  Sale[]
  expenses               Expense[]
  jobPosts               JobPost[]
  supplierProfile        SupplierProfile?
  supplierOrders         SupplierOrder[]         @relation("BuyerBusiness")
  supplierFavourites     SupplierFavourite[]
  hostingRequests        HostingServiceRequest[]
  hostingSubscriptions   HostingSubscription[]
  ecosystemSubscriptions EcosystemSubscription[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([province, verificationStatus, createdAt])
}

model BusinessMember {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  role       String   @default("OWNER")

  @@unique([businessId, userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())
}

model DriverProfile {
  id                 String             @id @default(cuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String             @unique
  address            String
  licenceNumber      String             @unique
  licenceExpiry      DateTime
  vehicleMake        String
  vehicleModel       String
  registration       String             @unique
  vehicleType        String
  vehicleColour      String
  vehiclePhotoUrl    String?
  documentRefs       String?
  paymentProfileRef  String?
  verificationStatus VerificationStatus @default(PENDING)
  isOnline           Boolean            @default(false)
  latitude           Float?
  longitude          Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model StockRequest {
  id                  String             @id @default(cuid())
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId          String
  supplierName        String
  notes               String?
  deliveryAddress     String
  allowAlternative    Boolean            @default(false)
  estimatedTotalCents Int                @default(0)
  actualTotalCents    Int?
  status              StockRequestStatus @default(DRAFT)
  driver              User?              @relation("AssignedDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driverId            String?
  receiptUrl          String?
  ownerApprovedAt     DateTime?
  deliveryPinHash     String?
  items               StockRequestItem[]
  reviews             Review[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  supplierOrder       SupplierOrder?
}

model StockRequestItem {
  id                 String       @id @default(cuid())
  request            StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId          String
  productName        String
  quantity           Int
  estimatedUnitCents Int
  actualUnitCents    Int?
  unavailable        Boolean      @default(false)
  alternative        String?
}

model PricingSetting {
  key        String   @id
  valueCents Int
  updatedAt  DateTime @updatedAt
}

model Review {
  id        String       @id @default(cuid())
  request   StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  author    User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  subject   User         @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  rating    Int
  comment   String?
  createdAt DateTime     @default(now())

  @@unique([requestId, authorId, subjectId])
}

model Product {
  id                String              @id @default(cuid())
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId        String
  sku               String
  barcode           String?
  name              String
  category          String
  costPriceCents    Int
  sellingPriceCents Int
  vatApplicable     Boolean             @default(false)
  reorderLevel      Int                 @default(0)
  supplier          String?
  storefrontVisible Boolean             @default(false)
  publicDescription String?
  imageUrl          String?
  movements         InventoryMovement[]
  saleItems         SaleItem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, category, createdAt])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId       String
  type            InventoryMovementType
  quantityDelta   Int
  unitCostCents   Int?
  reference       String?
  sourceRequestId String?
  createdAt       DateTime              @default(now())

  @@unique([sourceRequestId, productId])
  @@index([productId, createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId    String
  paymentMethod PaymentMethod
  subtotalCents Int
  discountCents Int           @default(0)
  totalCents    Int
  refundedAt    DateTime?
  items         SaleItem[]
  createdAt     DateTime      @default(now())
}

model SaleItem {
  id             String  @id @default(cuid())
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId         String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId      String
  quantity       Int
  unitPriceCents Int
}

model Expense {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  category    String
  supplier    String?
  amountCents Int
  reference   String?
  createdAt   DateTime @default(now())
}

model Wallet {
  id           String              @id @default(cuid())
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId       String              @unique
  currency     String              @default("ZAR")
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model WalletTransaction {
  id                 String                @id @default(cuid())
  wallet             Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletId           String
  type               WalletTransactionType
  amountCents        Int
  currency           String                @default("ZAR")
  reference          String                @unique
  status             FinancialStatus       @default(PENDING)
  relatedEntityType  String?
  relatedEntityId    String?
  reversalOfId       String?
  commissionSnapshot String?
  createdAt          DateTime              @default(now())

  @@index([walletId, createdAt])
}

model PaymentRecord {
  id                String        @id @default(cuid())
  provider          String
  providerReference String?       @unique
  idempotencyKey    String        @unique
  amountCents       Int
  currency          String        @default("ZAR")
  status            PaymentStatus @default(INITIATED)
  relatedEntityType String?
  relatedEntityId   String?
  metadata          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([relatedEntityType, relatedEntityId])
}

model CommissionRule {
  id                    String   @id @default(cuid())
  service               String
  commissionBasisPoints Int
  paymentFeeCents       Int      @default(0)
  vatBasisPoints        Int      @default(1500)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([service, active])
}

model ServiceProvider {
  id                 String             @id @default(cuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String             @unique
  businessName       String?
  categories         String
  skills             String
  experienceYears    Int
  description        String
  serviceRadiusKm    Int
  latitude           Float?
  longitude          Float?
  portfolioRefs      String?
  verificationStatus VerificationStatus @default(PENDING)
  quotes             ServiceQuote[]
  assignedRequests   ServiceRequest[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model ServiceRequest {
  id              String              @id @default(cuid())
  customer        User                @relation("ServiceCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  customerId      String
  category        String
  description     String
  photoRefs       String?
  address         String
  latitude        Float?
  longitude       Float?
  preferredDate   DateTime?
  urgency         String
  budgetCents     Int?
  status          ServiceJobStatus    @default(REQUESTED)
  provider        ServiceProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerId      String?
  acceptedQuoteId String?             @unique
  beforeEvidence  String?
  afterEvidence   String?
  completionNotes String?
  paymentHoldRef  String?
  quotes          ServiceQuote[]
  transitions     ServiceTransition[]
  reviews         ServiceReview[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([category, status])
}

model ServiceQuote {
  id                    String          @id @default(cuid())
  request               ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId             String
  provider              ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId            String
  labourCents           Int
  materialsCents        Int
  calloutCents          Int
  otherFeesCents        Int
  totalCents            Int
  notes                 String?
  estimatedDurationMins Int
  createdAt             DateTime        @default(now())

  @@unique([requestId, providerId])
}

model ServiceTransition {
  id        String            @id @default(cuid())
  request   ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  fromState ServiceJobStatus?
  toState   ServiceJobStatus
  actorId   String
  createdAt DateTime          @default(now())
}

model ServiceReview {
  id        String         @id @default(cuid())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  author    User           @relation("ServiceReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  subject   User           @relation("ServiceReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  rating    Int
  comment   String?
  createdAt DateTime       @default(now())

  @@unique([requestId, authorId])
}

model WorkerProfile {
  id                   String             @id @default(cuid())
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String             @unique
  location             String
  latitude             Float?
  longitude            Float?
  skills               String
  experienceYears      Int
  qualifications       String?
  cvUrl                String?
  certificateRefs      String?
  driverLicence        String?
  availability         String
  rateExpectationCents Int?
  verificationStatus   VerificationStatus @default(PENDING)
  assignments          WorkAssignment[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model JobPost {
  id             String           @id @default(cuid())
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId     String
  type           EmploymentType
  title          String
  description    String
  requiredSkills String
  location       String
  latitude       Float?
  longitude      Float?
  numberRequired Int
  rateCents      Int
  rateUnit       String
  startsAt       DateTime
  endsAt         DateTime?
  workingHours   String
  requirements   String?
  status         JobStatus        @default(OPEN)
  applications   JobApplication[]
  assignments    WorkAssignment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model JobApplication {
  id         String            @id @default(cuid())
  job        JobPost           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  worker     User              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId   String
  status     ApplicationStatus @default(APPLIED)
  matchScore Int
  coverNote  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([jobId, workerId])
  @@index([jobId, matchScore])
}

model WorkAssignment {
  id                   String           @id @default(cuid())
  job                  JobPost          @relation(fields: [jobId], references: [id], onDelete: Restrict)
  jobId                String
  worker               WorkerProfile    @relation(fields: [workerId], references: [id], onDelete: Restrict)
  workerId             String
  status               AssignmentStatus @default(PENDING_ACCEPTANCE)
  expectedPaymentCents Int?
  timeEntries          WorkTimeEntry[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@unique([jobId, workerId])
}

model WorkTimeEntry {
  id           String         @id @default(cuid())
  assignment   WorkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  checkedInAt  DateTime
  checkedOutAt DateTime?
  latitude     Float?
  longitude    Float?
  minutes      Int?
  createdAt    DateTime       @default(now())
}

model SupplierProfile {
  id                 String              @id @default(cuid())
  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId         String              @unique
  serviceAreas       String
  description        String?
  verificationStatus VerificationStatus  @default(PENDING)
  products           SupplierProduct[]
  orders             SupplierOrder[]
  favourites         SupplierFavourite[]
  promotions         SupplierPromotion[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model SupplierProduct {
  id                  String              @id @default(cuid())
  supplier            SupplierProfile     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId          String
  sku                 String
  name                String
  category            String
  wholesalePriceCents Int
  minimumQuantity     Int
  availableQuantity   Int
  active              Boolean             @default(true)
  orderItems          SupplierOrderItem[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([supplierId, sku])
  @@index([category, active])
}

model SupplierPromotion {
  id                  String          @id @default(cuid())
  supplier            SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId          String
  title               String
  description         String?
  discountBasisPoints Int
  startsAt            DateTime
  endsAt              DateTime
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
}

model SupplierFavourite {
  id         String          @id @default(cuid())
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId String
  createdAt  DateTime        @default(now())

  @@unique([businessId, supplierId])
}

model SupplierOrder {
  id              String              @id @default(cuid())
  buyer           Business            @relation("BuyerBusiness", fields: [buyerId], references: [id], onDelete: Restrict)
  buyerId         String
  supplier        SupplierProfile     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId      String
  status          SupplierOrderStatus @default(PLACED)
  subtotalCents   Int
  deliveryAddress String
  stockRequest    StockRequest?       @relation(fields: [stockRequestId], references: [id], onDelete: SetNull)
  stockRequestId  String?             @unique
  items           SupplierOrderItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model SupplierOrderItem {
  id             String          @id @default(cuid())
  order          SupplierOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  product        SupplierProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId      String
  productName    String
  quantity       Int
  unitPriceCents Int
}

model HostingPlan {
  id                String                @id @default(cuid())
  code              String                @unique
  name              String
  description       String
  monthlyPriceCents Int
  annualPriceCents  Int
  storageGb         Int
  websites          Int
  mailboxes         Int
  databases         Int
  sslIncluded       Boolean               @default(true)
  backupsIncluded   Boolean               @default(true)
  active            Boolean               @default(true)
  sortOrder         Int                   @default(0)
  subscriptions     HostingSubscription[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model HostingServiceRequest {
  id                String               @id @default(cuid())
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId        String
  serviceType       String
  domainName        String?
  requirements      String?
  status            HostingRequestStatus @default(REQUESTED)
  quotedAmountCents Int?
  adminNotes        String?
  provisioningJobs  ProvisionJob[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model HostingSubscription {
  id                String               @id @default(cuid())
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId        String
  plan              HostingPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  planId            String
  billingCycle      BillingCycle
  status            HostingRequestStatus @default(REQUESTED)
  domainName        String?
  providerReference String?
  renewsAt          DateTime?
  invoices          HostingInvoice[]
  domains           HostedDomain[]
  mailboxes         HostedMailbox[]
  provisioningJobs  ProvisionJob[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model HostedDomain {
  id                     String               @id @default(cuid())
  subscription           HostingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId         String?
  businessId             String
  domainName             String               @unique
  registrationYears      Int                  @default(1)
  registrationPriceCents Int
  status                 HostingRequestStatus @default(REQUESTED)
  providerReference      String?
  expiresAt              DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model HostedMailbox {
  id                String               @id @default(cuid())
  subscription      HostingSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId    String
  localPart         String
  domainName        String
  displayName       String?
  status            HostingRequestStatus @default(PROVISIONING)
  providerReference String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([subscriptionId, localPart, domainName])
}

model HostingInvoice {
  id             String              @id @default(cuid())
  subscription   HostingSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  subscriptionId String
  invoiceNumber  String              @unique
  amountCents    Int
  currency       String              @default("ZAR")
  status         InvoiceStatus       @default(ISSUED)
  dueAt          DateTime
  paidAt         DateTime?
  paymentId      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model ProvisionJob {
  id             String                 @id @default(cuid())
  request        HostingServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId      String?
  subscription   HostingSubscription?   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionId String?
  operation      String
  status         ProvisionStatus        @default(PENDING_ADMIN)
  provider       String
  payload        String?
  result         String?
  attempts       Int                    @default(0)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model Conversation {
  id           String                    @id @default(cuid())
  contextType  ConversationContext
  contextId    String
  subject      String?
  closedAt     DateTime?
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([contextType, contextId])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?
  mutedAt        DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
}

model Message {
  id             String              @id @default(cuid())
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  senderId       String
  text           String?
  hiddenAt       DateTime?
  hiddenReason   String?
  attachments    MessageAttachment[]
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String                @id @default(cuid())
  message   Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  type      MessageAttachmentType
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime              @default(now())
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  event     NotificationEvent
  channel   NotificationChannel
  subject   String?
  body      String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([event, channel])
}

model NotificationPreference {
  id        String              @id @default(cuid())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  channel   NotificationChannel
  event     NotificationEvent
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel, event])
}

model Notification {
  id                String                 @id @default(cuid())
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  event             NotificationEvent
  title             String
  body              String
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  archivedAt        DateTime?
  attempts          NotificationDelivery[]
  createdAt         DateTime               @default(now())

  @@index([userId, readAt, createdAt])
}

model NotificationDelivery {
  id             String                @id @default(cuid())
  notification   Notification          @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String
  channel        NotificationChannel
  status         DeliveryAttemptStatus @default(PENDING)
  provider       String?
  providerRef    String?
  error          String?
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([notificationId, channel])
}

model VerificationCase {
  id          String                 @id @default(cuid())
  type        VerificationType
  targetId    String
  applicant   User                   @relation("VerificationApplicant", fields: [applicantId], references: [id], onDelete: Restrict)
  applicantId String
  status      VerificationCaseStatus @default(PENDING)
  reviewer    User?                  @relation("VerificationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerId  String?
  submittedAt DateTime               @default(now())
  reviewedAt  DateTime?
  documents   VerificationDocument[]
  actions     VerificationAction[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([type, status, submittedAt])
  @@index([targetId])
}

model VerificationDocument {
  id           String           @id @default(cuid())
  case         VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId       String
  documentType String
  storageRef   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  checksum     String?
  createdAt    DateTime         @default(now())
}

model VerificationAction {
  id        String               @id @default(cuid())
  case      VerificationCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId    String
  actor     User                 @relation("VerificationActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorId   String
  decision  VerificationDecision
  reason    String?
  createdAt DateTime             @default(now())

  @@index([caseId, createdAt])
}

model SupportTicket {
  id              String               @id @default(cuid())
  ticketNumber    String               @unique
  requester       User                 @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  requesterId     String
  assignee        User?                @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId      String?
  category        SupportCategory
  priority        SupportPriority      @default(NORMAL)
  status          SupportStatus        @default(OPEN)
  subject         String
  description     String
  isDispute       Boolean              @default(false)
  contextType     String?
  contextId       String?
  financialHold   Boolean              @default(false)
  resolution      String?
  slaDueAt        DateTime
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  parties         SupportTicketParty[]
  evidence        SupportEvidence[]
  actions         SupportAction[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status, priority, slaDueAt])
  @@index([requesterId, createdAt])
  @@index([contextType, contextId])
}

model SupportTicketParty {
  id        String        @id @default(cuid())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId    String
  role      String
  createdAt DateTime      @default(now())

  @@unique([ticketId, userId])
}

model SupportEvidence {
  id          String        @id @default(cuid())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId    String
  uploadedBy  String
  storageRef  String
  fileName    String
  mimeType    String
  sizeBytes   Int
  description String?
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model SupportAction {
  id        String         @id @default(cuid())
  ticket    SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  actor     User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId   String
  action    String
  fromState SupportStatus?
  toState   SupportStatus?
  notes     String?
  createdAt DateTime       @default(now())

  @@index([ticketId, createdAt])
}

model EcosystemPlan {
  id            String                  @id @default(cuid())
  code          String                  @unique
  name          String
  description   String
  priceCents    Int
  billingPeriod EcosystemBillingPeriod
  features      String
  limits        String
  active        Boolean                 @default(true)
  sortOrder     Int                     @default(0)
  subscriptions EcosystemSubscription[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
}

model EcosystemSubscription {
  id                String                      @id @default(cuid())
  business          Business                    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId        String
  plan              EcosystemPlan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  planId            String
  status            EcosystemSubscriptionStatus @default(PENDING_PAYMENT)
  priceCents        Int
  billingPeriod     EcosystemBillingPeriod
  featuresSnapshot  String
  limitsSnapshot    String
  currentPeriodFrom DateTime?
  currentPeriodTo   DateTime?
  cancelledAt       DateTime?
  invoices          EcosystemInvoice[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([businessId, status])
}

model EcosystemInvoice {
  id             String                @id @default(cuid())
  subscription   EcosystemSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  subscriptionId String
  invoiceNumber  String                @unique
  amountCents    Int
  currency       String                @default("ZAR")
  status         InvoiceStatus         @default(ISSUED)
  dueAt          DateTime
  paidAt         DateTime?
  paymentId      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, dueAt])
}
