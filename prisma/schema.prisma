generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  DRIVER
  SERVICE_PROVIDER
  WORKER
  SUPPLIER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum StockRequestStatus {
  DRAFT
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  SHOPPING
  AWAITING_APPROVAL
  PURCHASED
  DELIVERING
  ARRIVED
  DELIVERED
  CANCELLED
  DISPUTED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
  TRANSFER
}

enum PaymentMethod {
  CASH
  CARD
  EFT
  HYDRA_WALLET
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  phone           String           @unique
  passwordHash    String
  firstName       String
  lastName        String
  status          AccountStatus    @default(ACTIVE)
  roles           UserRole[]
  businesses      BusinessMember[]
  sessions        Session[]
  auditLogs       AuditLog[]
  driverProfile   DriverProfile?
  drivingRequests StockRequest[]   @relation("AssignedDriver")
  reviewsWritten  Review[]         @relation("ReviewAuthor")
  reviewsReceived Review[]         @relation("ReviewSubject")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model UserRole {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role

  @@unique([userId, role])
}

model Business {
  id                 String           @id @default(cuid())
  name               String
  registrationNumber String?          @unique
  address            String?
  verificationStatus String           @default("PENDING")
  members            BusinessMember[]
  stockRequests      StockRequest[]
  products           Product[]
  sales              Sale[]
  expenses           Expense[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model BusinessMember {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  role       String   @default("OWNER")

  @@unique([businessId, userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())
}

model DriverProfile {
  id                 String             @id @default(cuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String             @unique
  address            String
  licenceNumber      String             @unique
  licenceExpiry      DateTime
  vehicleMake        String
  vehicleModel       String
  registration       String             @unique
  vehicleType        String
  vehicleColour      String
  vehiclePhotoUrl    String?
  documentRefs       String?
  paymentProfileRef  String?
  verificationStatus VerificationStatus @default(PENDING)
  isOnline           Boolean            @default(false)
  latitude           Float?
  longitude          Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model StockRequest {
  id                  String             @id @default(cuid())
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId          String
  supplierName        String
  notes               String?
  deliveryAddress     String
  allowAlternative    Boolean            @default(false)
  estimatedTotalCents Int                @default(0)
  actualTotalCents    Int?
  status              StockRequestStatus @default(DRAFT)
  driver              User?              @relation("AssignedDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driverId            String?
  receiptUrl          String?
  ownerApprovedAt     DateTime?
  deliveryPinHash     String?
  items               StockRequestItem[]
  reviews             Review[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model StockRequestItem {
  id                 String       @id @default(cuid())
  request            StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId          String
  productName        String
  quantity           Int
  estimatedUnitCents Int
  actualUnitCents    Int?
  unavailable        Boolean      @default(false)
  alternative        String?
}

model PricingSetting {
  key        String   @id
  valueCents Int
  updatedAt  DateTime @updatedAt
}

model Review {
  id        String       @id @default(cuid())
  request   StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  author    User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  subject   User         @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  rating    Int
  comment   String?
  createdAt DateTime     @default(now())

  @@unique([requestId, authorId, subjectId])
}

model Product {
  id                String              @id @default(cuid())
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId        String
  sku               String
  barcode           String?
  name              String
  category          String
  costPriceCents    Int
  sellingPriceCents Int
  vatApplicable     Boolean             @default(false)
  reorderLevel      Int                 @default(0)
  supplier          String?
  movements         InventoryMovement[]
  saleItems         SaleItem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId       String
  type            InventoryMovementType
  quantityDelta   Int
  unitCostCents   Int?
  reference       String?
  sourceRequestId String?
  createdAt       DateTime              @default(now())

  @@unique([sourceRequestId, productId])
  @@index([productId, createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId    String
  paymentMethod PaymentMethod
  subtotalCents Int
  discountCents Int           @default(0)
  totalCents    Int
  refundedAt    DateTime?
  items         SaleItem[]
  createdAt     DateTime      @default(now())
}

model SaleItem {
  id             String  @id @default(cuid())
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId         String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId      String
  quantity       Int
  unitPriceCents Int
}

model Expense {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  category    String
  supplier    String?
  amountCents Int
  reference   String?
  createdAt   DateTime @default(now())
}
