generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  DRIVER
  SERVICE_PROVIDER
  WORKER
  SUPPLIER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum StockRequestStatus {
  DRAFT
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  SHOPPING
  AWAITING_APPROVAL
  PURCHASED
  DELIVERING
  ARRIVED
  DELIVERED
  CANCELLED
  DISPUTED
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
  TRANSFER
}

enum PaymentMethod {
  CASH
  CARD
  EFT
  HYDRA_WALLET
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  REFUND
  COMMISSION
  WITHDRAWAL
  ADJUSTMENT
}

enum FinancialStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ServiceJobStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  WORK_STARTED
  COMPLETED
  CUSTOMER_CONFIRMED
  PAYMENT_RELEASED
  REVIEWED
  CANCELLED
  DISPUTED
}

model User {
  id                     String           @id @default(cuid())
  email                  String           @unique
  phone                  String           @unique
  passwordHash           String
  firstName              String
  lastName               String
  status                 AccountStatus    @default(ACTIVE)
  roles                  UserRole[]
  businesses             BusinessMember[]
  sessions               Session[]
  auditLogs              AuditLog[]
  driverProfile          DriverProfile?
  drivingRequests        StockRequest[]   @relation("AssignedDriver")
  reviewsWritten         Review[]         @relation("ReviewAuthor")
  reviewsReceived        Review[]         @relation("ReviewSubject")
  wallet                 Wallet?
  serviceProvider        ServiceProvider?
  serviceRequests        ServiceRequest[] @relation("ServiceCustomer")
  serviceReviewsWritten  ServiceReview[]  @relation("ServiceReviewAuthor")
  serviceReviewsReceived ServiceReview[]  @relation("ServiceReviewSubject")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

model UserRole {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  role   Role

  @@unique([userId, role])
}

model Business {
  id                 String           @id @default(cuid())
  name               String
  registrationNumber String?          @unique
  address            String?
  verificationStatus String           @default("PENDING")
  members            BusinessMember[]
  stockRequests      StockRequest[]
  products           Product[]
  sales              Sale[]
  expenses           Expense[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model BusinessMember {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  role       String   @default("OWNER")

  @@unique([businessId, userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  metadata  String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  createdAt DateTime @default(now())
}

model DriverProfile {
  id                 String             @id @default(cuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String             @unique
  address            String
  licenceNumber      String             @unique
  licenceExpiry      DateTime
  vehicleMake        String
  vehicleModel       String
  registration       String             @unique
  vehicleType        String
  vehicleColour      String
  vehiclePhotoUrl    String?
  documentRefs       String?
  paymentProfileRef  String?
  verificationStatus VerificationStatus @default(PENDING)
  isOnline           Boolean            @default(false)
  latitude           Float?
  longitude          Float?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model StockRequest {
  id                  String             @id @default(cuid())
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId          String
  supplierName        String
  notes               String?
  deliveryAddress     String
  allowAlternative    Boolean            @default(false)
  estimatedTotalCents Int                @default(0)
  actualTotalCents    Int?
  status              StockRequestStatus @default(DRAFT)
  driver              User?              @relation("AssignedDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driverId            String?
  receiptUrl          String?
  ownerApprovedAt     DateTime?
  deliveryPinHash     String?
  items               StockRequestItem[]
  reviews             Review[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model StockRequestItem {
  id                 String       @id @default(cuid())
  request            StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId          String
  productName        String
  quantity           Int
  estimatedUnitCents Int
  actualUnitCents    Int?
  unavailable        Boolean      @default(false)
  alternative        String?
}

model PricingSetting {
  key        String   @id
  valueCents Int
  updatedAt  DateTime @updatedAt
}

model Review {
  id        String       @id @default(cuid())
  request   StockRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  author    User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  subject   User         @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  rating    Int
  comment   String?
  createdAt DateTime     @default(now())

  @@unique([requestId, authorId, subjectId])
}

model Product {
  id                String              @id @default(cuid())
  business          Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId        String
  sku               String
  barcode           String?
  name              String
  category          String
  costPriceCents    Int
  sellingPriceCents Int
  vatApplicable     Boolean             @default(false)
  reorderLevel      Int                 @default(0)
  supplier          String?
  movements         InventoryMovement[]
  saleItems         SaleItem[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([businessId, sku])
  @@unique([businessId, barcode])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  product         Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId       String
  type            InventoryMovementType
  quantityDelta   Int
  unitCostCents   Int?
  reference       String?
  sourceRequestId String?
  createdAt       DateTime              @default(now())

  @@unique([sourceRequestId, productId])
  @@index([productId, createdAt])
}

model Sale {
  id            String        @id @default(cuid())
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessId    String
  paymentMethod PaymentMethod
  subtotalCents Int
  discountCents Int           @default(0)
  totalCents    Int
  refundedAt    DateTime?
  items         SaleItem[]
  createdAt     DateTime      @default(now())
}

model SaleItem {
  id             String  @id @default(cuid())
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId         String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productId      String
  quantity       Int
  unitPriceCents Int
}

model Expense {
  id          String   @id @default(cuid())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId  String
  category    String
  supplier    String?
  amountCents Int
  reference   String?
  createdAt   DateTime @default(now())
}

model Wallet {
  id           String              @id @default(cuid())
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId       String              @unique
  currency     String              @default("ZAR")
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model WalletTransaction {
  id                 String                @id @default(cuid())
  wallet             Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletId           String
  type               WalletTransactionType
  amountCents        Int
  currency           String                @default("ZAR")
  reference          String                @unique
  status             FinancialStatus       @default(PENDING)
  relatedEntityType  String?
  relatedEntityId    String?
  reversalOfId       String?
  commissionSnapshot String?
  createdAt          DateTime              @default(now())

  @@index([walletId, createdAt])
}

model PaymentRecord {
  id                String        @id @default(cuid())
  provider          String
  providerReference String?       @unique
  idempotencyKey    String        @unique
  amountCents       Int
  currency          String        @default("ZAR")
  status            PaymentStatus @default(INITIATED)
  relatedEntityType String?
  relatedEntityId   String?
  metadata          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model CommissionRule {
  id                    String   @id @default(cuid())
  service               String
  commissionBasisPoints Int
  paymentFeeCents       Int      @default(0)
  vatBasisPoints        Int      @default(1500)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([service, active])
}

model ServiceProvider {
  id                 String             @id @default(cuid())
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String             @unique
  businessName       String?
  categories         String
  skills             String
  experienceYears    Int
  description        String
  serviceRadiusKm    Int
  latitude           Float?
  longitude          Float?
  portfolioRefs      String?
  verificationStatus VerificationStatus @default(PENDING)
  quotes             ServiceQuote[]
  assignedRequests   ServiceRequest[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model ServiceRequest {
  id              String              @id @default(cuid())
  customer        User                @relation("ServiceCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  customerId      String
  category        String
  description     String
  photoRefs       String?
  address         String
  latitude        Float?
  longitude       Float?
  preferredDate   DateTime?
  urgency         String
  budgetCents     Int?
  status          ServiceJobStatus    @default(REQUESTED)
  provider        ServiceProvider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  providerId      String?
  acceptedQuoteId String?             @unique
  beforeEvidence  String?
  afterEvidence   String?
  completionNotes String?
  paymentHoldRef  String?
  quotes          ServiceQuote[]
  transitions     ServiceTransition[]
  reviews         ServiceReview[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([category, status])
}

model ServiceQuote {
  id                    String          @id @default(cuid())
  request               ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId             String
  provider              ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId            String
  labourCents           Int
  materialsCents        Int
  calloutCents          Int
  otherFeesCents        Int
  totalCents            Int
  notes                 String?
  estimatedDurationMins Int
  createdAt             DateTime        @default(now())

  @@unique([requestId, providerId])
}

model ServiceTransition {
  id        String            @id @default(cuid())
  request   ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  fromState ServiceJobStatus?
  toState   ServiceJobStatus
  actorId   String
  createdAt DateTime          @default(now())
}

model ServiceReview {
  id        String         @id @default(cuid())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String
  author    User           @relation("ServiceReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  subject   User           @relation("ServiceReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String
  rating    Int
  comment   String?
  createdAt DateTime       @default(now())

  @@unique([requestId, authorId])
}
