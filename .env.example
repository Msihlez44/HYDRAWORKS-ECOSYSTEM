DATABASE_URL="postgresql://hydraworks:change-this-local-password@localhost:5432/hydraworks?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=3000
NODE_ENV=development
APP_ORIGIN="http://localhost:5173"
AUTH_RATE_LIMIT=10
PAYMENT_MODE=sandbox
PAYMENT_WEBHOOK_SECRET="replace-with-at-least-24-random-characters"
HOSTING_PROVIDER=manual
DOMAIN_COZA_PRICE_CENTS=14900
# SEED_ADMIN_PASSWORD must be supplied securely when running npm run db:seed
UPLOAD_DIR="./uploads"
BACKUP_DIR="./backups"
